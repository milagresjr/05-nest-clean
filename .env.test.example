# Copie este arquivo para .env.test e ajuste os valores conforme necessário:
#   cp .env.test.example .env.test
# O banco de TESTE precisa existir e a URL deve conter "nest-clean-test"
# (há um guard nos testes e2e que aborta caso contrário).
#   docker compose exec postgres createdb -U postgres nest-clean-test

DATABASE_URL="postgresql://postgres:docker@localhost:5432/nest-clean-test?schema=public"

# As mesmas chaves do .env (geradas por `npm run setup`).
JWT_PRIVATE_KEY="CHANGE_ME_JWT_PRIVATE_KEY"
JWT_PUBLIC_KEY="CHANGE_ME_JWT_PUBLIC_KEY"

PORT=3333

# Connection pool (pg)
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
DATABASE_POOL_MAX_USES=10000