# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env
# Ou gere automaticamente um .env funcional com: npm run setup

DATABASE_URL="postgresql://postgres:docker@localhost:5432/nest-clean?schema=public"

# Par de chaves RSA em base64 (geradas por `npm run setup` ou manualmente).
JWT_PRIVATE_KEY="CHANGE_ME_JWT_PRIVATE_KEY"
JWT_PUBLIC_KEY="CHANGE_ME_JWT_PUBLIC_KEY"

PORT=3333

# Connection pool (pg)
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
DATABASE_POOL_MAX_USES=10000